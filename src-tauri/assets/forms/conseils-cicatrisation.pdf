946 0 obj
  << /ActualText (\311tape 1 \024 Retirer le pansement\nRetirez le pansement selon les indications donn\351es par votre tatoueur et les recommandations du fabricant si un pansement sp\351cifique a \351t\351 pos\351\056 Ne le remplacez pas par un autre dispositif sans consigne adapt\351e\056\n\n\311tape 2 \024 Nettoyer le tatouage\nLavez\055vous soigneusement les mains avant chaque soin\056\nNettoyez d\351licatement la zone avec de l\031eau ti\350de et un savon doux\054 sans parfum\056\nNe frottez pas et ne grattez pas la peau\056\nRincez soigneusement\054 puis s\351chez en tamponnant doucement avec un essuie\055tout propre \340 usage unique\056)
     /K [ 3 ]
     /P 947 0 R
     /Pg 940 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

947 0 obj
  << /K [ 946 0 R ]
     /P 970 0 R
     /S /P
     /Pg 940 0 R
     /Type /StructElem
  >>
endobj

948 0 obj
  << /ActualText (\311tape 3 \024 Hydrater la peau\nAppliquez une fine couche de cr\350me adapt\351e \340 la cicatrisation\054 selon les recommandations de votre tatoueur\056\n\311vitez les couches \351paisses qui maintiennent la peau trop humide\056\nNe multipliez pas les produits et n\031appliquez aucun produit irritant sur la zone tatou\351e\056\n\n\311tape 4 \024 Laisser cicatriser\nLaissez la peau se renouveler naturellement\056\nDe l\351g\350res cro\373tes\054 des d\351mangeaisons et une desquamation peuvent appara\356tre\056\nNe grattez pas les cro\373tes et ne retirez pas les petites peaux qui se d\351tachent\056)
     /K [ 4 ]
     /P 949 0 R
     /Pg 940 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

